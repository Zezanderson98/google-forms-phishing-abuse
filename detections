
/detections/rules.yara

rule Detect_Google_Forms_Phishing_Abuse {
    meta:
        description = "Detects malicious Google Form response receipts pointing to high-risk cloud hosting subdomains"
        author = "Threat Intel Analyst"
        date = "2026-09-27"
        reference = "Internal Analysis"
        severity = "High"

    strings:
        // Core structural indicators of a Google Form receipt
        $header_from = "From: Forms response receipts <forms-receipts-noreply@google.com>"
        $header_bounce = "://google.com"
        
        // Subject or body text indicators observed in this campaign
        $body_text_1 = "Thanks for filling in this form:"
        $body_text_2 = "Special reward available: check the test results"
        
        // Malicious redirection platforms often used in this string pattern
        $mal_url_domain = ".pages.dev"

    condition:
        all of ($header_*) and (any of ($body_text_*)) and $mal_url_domain
}

